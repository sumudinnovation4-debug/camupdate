{
  "appId": "com.camplugie.app",
  "appName": "Camplugie",
  "webDir": "www",
  "backgroundColor": "#0E0A1D",
  "appendUserAgent": "CamplugieApp/1.0",
  "server": {
    "url": "https://camplugie.com/home.html",
    "androidScheme": "https",
    "cleartext": false,
    "errorPath": "offline.html",
    "allowNavigation": [
      "camplugie.com", "*.camplugie.com",
      "*.supabase.co",
      "*.paystack.co", "*.paystack.com",
      "*.cloudinary.com",
      "*.openstreetmap.org", "*.tile.openstreetmap.org", "photon.komoot.io", "router.project-osrm.org",
      "unpkg.com", "cdn.jsdelivr.net", "cdnjs.cloudflare.com", "fonts.googleapis.com", "fonts.gstatic.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": { "insetsHandling": "css", "style": "DARK", "initialViewportFitValueHint": "cover" },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
