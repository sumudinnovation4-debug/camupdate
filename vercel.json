{
  "headers": [
    {
      "source": "/downloads/camplugie.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Camplugie.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/install",
      "destination": "/download.html"
    },
    {
      "source": "/api/push-event",
      "destination": "/api/hub?r=push-event"
    },
    {
      "source": "/api/push-test",
      "destination": "/api/hub?r=push-test"
    },
    {
      "source": "/api/notify-call",
      "destination": "/api/hub?r=notify-call"
    },
    {
      "source": "/api/notify-message",
      "destination": "/api/hub?r=notify-message"
    },
    {
      "source": "/api/notify-group-message",
      "destination": "/api/hub?r=notify-group-message"
    },
    {
      "source": "/api/send-push",
      "destination": "/api/hub?r=send-push"
    },
    {
      "source": "/api/delete-account",
      "destination": "/api/hub?r=delete-account"
    },
    {
      "source": "/api/quick-reply",
      "destination": "/api/hub?r=quick-reply"
    },
    {
      "source": "/api/call-decline",
      "destination": "/api/hub?r=call-decline"
    }
  ],
  "functions": {
    "api/hub.js": {
      "maxDuration": 60
    }
  }
}
